# VHS tape for duck. Render with: vhs docs/tapes/duck.tape
Output docs/img/duck.gif

Set Shell "bash"
Set FontSize 18
Set Width 1000
Set Height 420
Set Theme "Catppuccin Mocha"
Set Padding 16

Type "duck --seed 1"
Enter
Sleep 1s
Type "so the bug only happens on Tuesdays"
Enter
Sleep 1500ms
Type "and only in production"
Enter
Sleep 1500ms
Type "I think it's a race condition"
Enter
Sleep 2s
Ctrl+D
Sleep 800ms
