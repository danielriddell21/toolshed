# VHS tape for garden. Render with: vhs docs/tapes/garden.tape
Output docs/img/garden.gif

Set Shell "bash"
Set FontSize 18
Set Width 1000
Set Height 400
Set Theme "Catppuccin Mocha"
Set Padding 16

Type "garden"
Enter
Sleep 1s
Right@250ms 8
Down@250ms 3
Left@250ms 5
Type "p"
Down@250ms 2
Right@250ms 6
Sleep 2s
Type "q"
Sleep 500ms
