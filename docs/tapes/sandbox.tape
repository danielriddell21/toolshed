# VHS tape for sandbox. Render with: vhs docs/tapes/sandbox.tape
Output docs/img/sandbox.gif

Set Shell "bash"
Set FontSize 16
Set Width 1000
Set Height 600
Set Theme "Catppuccin Mocha"
Set Padding 10

Type "sandbox --count 8" Sleep 500ms
Enter
Sleep 2s
Space Sleep 400ms
Space Sleep 400ms
Space Sleep 400ms
Type "g" Sleep 2s
Type "q"
Sleep 500ms
