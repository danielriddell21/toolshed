# VHS tape for fractal. Render with: vhs docs/tapes/fractal.tape
Output docs/img/fractal.gif

Set Shell "bash"
Set FontSize 16
Set Width 1000
Set Height 600
Set Theme "Catppuccin Mocha"
Set Padding 10

Type "fractal"
Enter
Sleep 2s
Type "+" Sleep 400ms
Type "+" Sleep 400ms
Type "+" Sleep 600ms
Right@200ms 3
Down@200ms 2
Sleep 800ms
Type "]" Sleep 800ms
Type "j" Sleep 1500ms
Type "q"
Sleep 500ms
